# Copy to .env.local for a local run. Never commit real values.
DEPLOYMENT_TARGET=test
DEPLOYMENT_ID=local
DATABASE_URL=postgresql:///leasing_test?host=/tmp
PGSOCKET_PATH=/tmp/.s.PGSQL.5432
OUTBOUND_ALLOWLIST=email:*@tenants.example.test,email:*@prospects.example.test,email:*@office.example.test,sms:+1555010*
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Clerk DEVELOPMENT instance keys only (pk_test_ / sk_test_). A pk_live_ or sk_live_ key stops every process.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# A +clerk_test identity: Clerk sends no email for it.
E2E_CLERK_USER_EMAIL=leasing-qa+clerk_test@example.com
E2E_CLERK_USER_PASSWORD=
